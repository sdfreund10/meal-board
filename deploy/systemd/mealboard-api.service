[Unit]
Description=Mealboard API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=mealboard
Group=mealboard
WorkingDirectory=/opt/mealboard/backend
EnvironmentFile=-/opt/mealboard/backend/.env
ExecStart=/opt/mealboard/backend/.venv/bin/uvicorn app.main:app \
  --host 127.0.0.1 \
  --port 8000 \
  --proxy-headers \
  --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5

# Harden without blocking loopback proxy or local Postgres.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/mealboard

[Install]
WantedBy=multi-user.target
